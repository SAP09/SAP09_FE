{
    "_version": "1.59.0",
    "sap.app": {
        "id": "odata.metadata.manager",
        "type": "application",
        "sap.platform": "ABAP",
        "title": "OData Metadata Manager",
        "description": "Manage, compare and snapshot OData service metadata versions",
        "applicationVersion": {
            "version": "1.0.0"
        },
        "crossNavigation": {
            "inbounds": {
                "display": {
                    "semanticObject": "ODataMetadataManager",
                    "action": "display",
                    "title": "OData Metadata Manager",
                    "signature": {
                        "parameters": {},
                        "additionalParameters": "allowed"
                    }
                }
            }
        },
        "dataSources": {
            "mainOData": {
                "uri": "/sap/opu/odata4/sap/zsb_gsugp9/srvd_a2x/sap/zsr_registry/0001/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0",
                    "localUri": "localService/metadata.xml"
                }
            }
        },
        "backend": {
            "enabled": true,
            "url": "/sap/opu/odata4/sap/zsb_gsugp9/srvd_a2x/sap/zsr_registry/0001/",
            "host": "",
            "servicePath": "/sap/opu/odata4/sap/zsb_gsugp9/srvd_a2x/sap/zsr_registry/0001/",
            "sapClient": "324",
            "odataVersion": "v4",
            "authType": "basic"
        },
        "sourceTemplate": {
            "id": "@sap/ux-app-migrator:freestyle",
            "version": "1.27.0",
            "toolsId": "9111958f-061b-41b0-aee2-9981fb03c90c"
        }
    },
    "sap.cloud": {
        "service": "odata.metadata.manager"
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "sap-icon://database",
            "favIcon": "",
            "phone": "",
            "phone@2": "",
            "tablet": "",
            "tablet@2": ""
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": false
        },
        "supportedThemes": [
            "sap_horizon",
            "sap_fiori_3"
        ]
    },
    "sap.ui5": {
        "rootView": {
            "viewName": "odata.metadata.manager.view.App",
            "type": "XML",
            "id": "app"
        },
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        },
        "dependencies": {
            "minUI5Version": "1.108.30",
            "libs": {
                "sap.m": {},
                "sap.ui.layout": {},
                "sap.f": {},
                "sap.ui.unified": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "": {
                "type": "sap.ui.model.json.JSONModel",
                "settings": {
                    "defaultBindingMode": "TwoWay"
                }
            }
        },
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "viewType": "XML",
                "path": "odata.metadata.manager.view",
                "controlId": "navContainer",
                "controlAggregation": "pages",
                "async": true
            },
            "routes": [
                {
                    "name": "dashboard",
                    "pattern": "",
                    "target": [
                        "dashboard"
                    ]
                },
                {
                    "name": "versionCompare",
                    "pattern": "compare/{service}",
                    "target": [
                        "versionCompare"
                    ]
                },
                {
                    "name": "snapshotDetail",
                    "pattern": "snapshot/{service}/{version}",
                    "target": [
                        "snapshotDetail"
                    ]
                }
            ],
            "targets": {
                "dashboard": {
                    "viewType": "XML",
                    "viewName": "Dashboard",
                    "viewId": "dashboard"
                },
                "versionCompare": {
                    "viewType": "XML",
                    "viewName": "VersionCompare",
                    "viewId": "versionCompare"
                },
                "snapshotDetail": {
                    "viewType": "XML",
                    "viewName": "SnapshotDetail",
                    "viewId": "snapshotDetail"
                }
            }
        }
    }
}