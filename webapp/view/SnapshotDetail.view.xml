<mvc:View
    controllerName="odata.metadata.manager.controller.SnapshotDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    height="100%"
    displayBlock="true">

    <Page id="versionDetailPage" showHeader="true" enableScrolling="false" class="versionDetailPage">

        <!-- ═══════ TOP BAR ═══════ -->
        <customHeader>
            <Bar class="appTopBar">
                <contentLeft>
                    <Button icon="sap-icon://nav-back" press="onNavBack" class="backBtn" />
                    <core:Icon src="sap-icon://camera" size="1.125rem" class="topBarIcon" />
                    <Title id="versionTitle" text="Version" class="topBarTitle" />
                    <Text id="badgeTrigger" text="—" class="badge badge-auto" />
                    <Text id="badgeVersionType" text="—" class="badge badge-v2" />
                    <Text id="badgePrefix" text="—" class="badge badge-zi" />
                    <Text id="badgeStatus" text="—" class="badge badge-active" />
                </contentLeft>
                <contentRight>
                    <Button icon="sap-icon://compare"  text="Compare to…"  press="onCompareTo"      class="topBarBtn" />
                    <Button icon="sap-icon://download" text="Download XML"  press="onDownloadXml"    type="Emphasized" />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox class="versionDetailBody">

                <!-- ═══════ METADATA ROW ═══════ -->
                <HBox class="metaRow" alignItems="Stretch">
                    <VBox class="metaCell">
                        <Text text="SERVICE" class="metaCellLabel" />
                        <Text id="metaService" text="—" class="metaCellValue" />
                    </VBox>
                    <VBox class="metaCell">
                        <Text text="VERSION DATE" class="metaCellLabel" />
                        <Text id="metaDate" text="—" class="metaCellValue" />
                    </VBox>
                    <VBox class="metaCell">
                        <Text text="CREATED BY" class="metaCellLabel" />
                        <Text id="metaCreatedBy" text="—" class="metaCellValue" />
                    </VBox>
                    <VBox class="metaCell">
                        <Text text="TRANSPORT" class="metaCellLabel" />
                        <Text id="metaTransport" text="—" class="metaCellValue metaMono" />
                    </VBox>
                    <VBox class="metaCell">
                        <Text text="TRIGGERING APP" class="metaCellLabel" />
                        <Text id="metaTriggeringApp" text="—" class="metaCellValue" />
                    </VBox>
                    <VBox class="metaCell">
                        <Text text="HASH" class="metaCellLabel" />
                        <Text id="metaHash" text="—" class="metaCellValue metaMono" />
                    </VBox>
                </HBox>

                <!-- ═══════ TWO-PANEL BODY ═══════ -->
                <HBox class="detailTwoPanel" alignItems="Stretch">

                    <!-- ─── LEFT: Entity Tree (200px) ─── -->
                    <VBox class="entityTreePanel" id="entityTreePanel">

                        <!-- Panel header -->
                        <HBox class="entityPanelHeader" alignItems="Center">
                            <core:Icon src="sap-icon://tree" size="0.875rem" class="entityPanelIcon" />
                            <Text id="entityTreeTitle" text="Entity tree" class="entityPanelTitle" />
                        </HBox>

                        <!-- Search -->
                        <SearchField
                            id="entitySearch"
                            placeholder="Filter…"
                            width="100%"
                            liveChange="onEntitySearch"
                            class="entitySearchField" />

                        <!-- Scrollable tree -->
                        <ScrollContainer vertical="true" horizontal="false" class="entityTreeScroll">
                            <VBox id="entityTreeContainer" class="entityTree" />
                        </ScrollContainer>
                    </VBox>

                    <!-- ─── RIGHT: Tabbed Content ─── -->
                    <VBox class="versionRightPane">
                        <IconTabBar
                            id="versionTabBar"
                            select="onTabSelect"
                            class="versionTabBar"
                            expandable="false">

                            <!-- TAB 1: Raw XML -->
                            <items>
                                <IconTabFilter
                                    id="tabXml"
                                    key="xml"
                                    icon="sap-icon://source-code"
                                    text="Raw XML">
                                    <content>
                                        <core:HTML id="xmlHtmlControl" preferDOM="true" />
                                    </content>
                                </IconTabFilter>

                                <!-- TAB 2: Approval Workflow -->
                                <IconTabFilter
                                    id="tabWorkflow"
                                    key="workflow"
                                    icon="sap-icon://workflow-tasks"
                                    text="Approval workflow">
                                    <content>
                                        <ScrollContainer vertical="true" horizontal="false" class="wfScrollArea">
                                            <VBox class="workflowPane">
                                                <Text id="wfPaneSubtitle" text="Event chain that triggered this capture" class="wfPaneSubtitle" />

                                                <!-- Step 1: Transport released -->
                                                <HBox class="wfStep" alignItems="Start">
                                                    <VBox class="wfDotCol" alignItems="Center">
                                                        <core:HTML content="&lt;div class='wf-dot dot-green'&gt;&lt;/div&gt;&lt;div class='wf-line'&gt;&lt;/div&gt;" />
                                                    </VBox>
                                                    <VBox class="wfCard">
                                                        <HBox class="wfCardTop" alignItems="Center">
                                                            <Text text="Transport released" class="wfActor" />
                                                            <Text text="TR#K9A002 imported to PRD" class="wfAction" />
                                                            <ToolbarSpacer />
                                                            <Text text="Today 05:48" class="wfTime" />
                                                        </HBox>
                                                        <Text text="App: ZMM_PURCHASE_UI · imported by BASIS team · system detected version table update" class="wfDetail" wrapping="true" />
                                                    </VBox>
                                                </HBox>

                                                <!-- Step 2: Auto-scan triggered -->
                                                <HBox class="wfStep" alignItems="Start">
                                                    <VBox class="wfDotCol" alignItems="Center">
                                                        <core:HTML content="&lt;div class='wf-dot dot-blue'&gt;&lt;/div&gt;&lt;div class='wf-line'&gt;&lt;/div&gt;" />
                                                    </VBox>
                                                    <VBox class="wfCard">
                                                        <HBox class="wfCardTop" alignItems="Center">
                                                            <Text text="Auto-scan triggered" class="wfActor" />
                                                            <Text text="ZODATA_SCHEDULER detected version change" class="wfAction" />
                                                            <ToolbarSpacer />
                                                            <Text text="Today 06:00" class="wfTime" />
                                                        </HBox>
                                                        <Text text="Version table updated → daily job fired 2 min early · hash check: NEW (differs from v6)" class="wfDetail" wrapping="true" />
                                                    </VBox>
                                                </HBox>

                                                <!-- Step 3: Metadata fetched -->
                                                <HBox class="wfStep" alignItems="Start">
                                                    <VBox class="wfDotCol" alignItems="Center">
                                                        <core:HTML content="&lt;div class='wf-dot dot-blue'&gt;&lt;/div&gt;&lt;div class='wf-line'&gt;&lt;/div&gt;" />
                                                    </VBox>
                                                    <VBox class="wfCard">
                                                        <HBox class="wfCardTop" alignItems="Center">
                                                            <Text text="Metadata fetched" class="wfActor" />
                                                            <Text text="SYSTEM called /IWFND/CL_SODATA_EDM_PROVIDER" class="wfAction" />
                                                            <ToolbarSpacer />
                                                            <Text text="Today 06:00:03" class="wfTime" />
                                                        </HBox>
                                                        <Text text="Raw $metadata XML retrieved · compressed to XSTRING · 14 entity types parsed" class="wfDetail" wrapping="true" />
                                                    </VBox>
                                                </HBox>

                                                <!-- Step 4: Version written -->
                                                <HBox class="wfStep" alignItems="Start">
                                                    <VBox class="wfDotCol" alignItems="Center">
                                                        <core:HTML content="&lt;div class='wf-dot dot-blue'&gt;&lt;/div&gt;&lt;div class='wf-line'&gt;&lt;/div&gt;" />
                                                    </VBox>
                                                    <VBox class="wfCard">
                                                        <HBox class="wfCardTop" alignItems="Center">
                                                            <Text text="Version written" class="wfActor" />
                                                            <Text text="v7 stored in ZODATA_VERSIONS" class="wfAction" />
                                                            <ToolbarSpacer />
                                                            <Text text="Today 06:00:04" class="wfTime" />
                                                        </HBox>
                                                        <Text text="Hash: a4f8c2d1… · immutable · audit logged to ZODATA_LOG · is_deleted=false" class="wfDetail" wrapping="true" />
                                                    </VBox>
                                                </HBox>

                                                <!-- Step 5: Viewed -->
                                                <HBox class="wfStep wfStep-last" alignItems="Start">
                                                    <VBox class="wfDotCol" alignItems="Center">
                                                        <core:HTML content="&lt;div class='wf-dot dot-grey'&gt;&lt;/div&gt;" />
                                                    </VBox>
                                                    <VBox class="wfCard">
                                                        <HBox class="wfCardTop" alignItems="Center">
                                                            <Text text="Viewed" class="wfActor" />
                                                            <Text text="JDOE opened version detail" class="wfAction" />
                                                            <ToolbarSpacer />
                                                            <Text text="Today 09:15" class="wfTime" />
                                                        </HBox>
                                                        <Text text="Action: VIEW · logged to ZODATA_LOG · no modification" class="wfDetail" wrapping="true" />
                                                    </VBox>
                                                </HBox>

                                            </VBox>
                                        </ScrollContainer>
                                    </content>
                                </IconTabFilter>
                            </items>
                        </IconTabBar>
                    </VBox>

                </HBox>

                <!-- ═══════ FOOTER BAR ═══════ -->
                <Bar class="versionFooter">
                    <contentLeft>
                        <core:Icon src="sap-icon://document-text" size="0.875rem" />
                        <Text text="$metadata.xml · 50 lines · 3.6 KB · UTF-8" class="footerFileInfo" />
                    </contentLeft>
                    <contentMiddle>
                        <Text text="Hash: a4f8c2d1e9b3f7a0 · Immutable · is_deleted=false" class="footerHashInfo" />
                    </contentMiddle>
                    <contentRight>
                        <Button text="All 7 versions as ZIP"  icon="sap-icon://attachment-zip-file" press="onExportAllZip"    class="footerBtn" />
                        <Button text="Selected versions"      icon="sap-icon://multi-select"         press="onExportSelected" class="footerBtn" />
                    </contentRight>
                </Bar>

            </VBox>
        </content>
    </Page>
</mvc:View>
